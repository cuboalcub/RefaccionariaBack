# Copia este archivo a .env y ajusta los valores
SECRET_KEY=tu_secret_key_aqui
DEBUG=True

# Opcional: en producción usa Postgres
# DATABASE_URL=postgres://usuario:password@host:5432/refaccionaria

# CORS - lista separada por comas de orígenes permitidos (frontend)
# Para desarrollo local ya incluye http://localhost:5173 y :3000 por defecto
# En producción define la URL de tu frontend desplegado:
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-frontend.onrender.com
# FRONTEND_URL=https://tu-frontend.vercel.app
# Para permitir previews de Vercel (opcional):
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# Solo para pruebas locales sin config (no usar en prod):
# CORS_ALLOW_ALL_ORIGINS=False
